# === Discord ===
# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# IDs de servidores para sincronizar slash commands instantaneamente (dev).
# Separe por virgula. Deixe vazio em producao para sync global.
DEV_GUILD_IDS=

# === Banco de dados ===
# Caminho do arquivo SQLite (use um volume persistente em producao).
DATABASE_PATH=data/melodybot.db

# === Planos / Monetizacao ===
# Limite de faixas na fila para o plano Free.
FREE_QUEUE_LIMIT=20
# Duracao maxima de faixa (segundos) no plano Free. 0 = sem limite.
FREE_MAX_TRACK_SECONDS=1800

# === Pagamento (Mercado Pago) — OPCIONAL ===
# Deixe vazio para desabilitar pagamentos (o bot roda normal sem isso).
# NUNCA comite as chaves reais. Configure via variaveis de ambiente do host.
PAYMENT_PROVIDER=none
MERCADOPAGO_ACCESS_TOKEN=
# URL publica que recebe o webhook de pagamento (ex: https://seu-host/webhook/mercadopago)
PAYMENT_WEBHOOK_BASE_URL=
# Porta do servidor de webhook interno.
WEBHOOK_PORT=8080
# Preco do plano Premium (BRL).
PREMIUM_PRICE_BRL=9.90

# === IA (DJ inteligente) — OPCIONAL ===
# Habilita /vibe (DJ por humor) e autoplay inteligente.
# Deixe 'none' para desabilitar. NUNCA comite a chave real.
AI_PROVIDER=none
GEMINI_API_KEY=
# Modelo Gemini (opcional). Padrao: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# === YouTube / yt-dlp ===
# Em IPs de datacenter (cloud), o YouTube pode exigir login com a mensagem
# "Sign in to confirm you're not a bot". Ajustes para contornar:
# Client do player usado pelo yt-dlp (android/ios/tv/web). Padrao: android.
YTDL_PLAYER_CLIENT=android
# Caminho para um cookies.txt (formato Netscape) exportado de uma conta logada
# no YouTube. Usado so se o arquivo existir. Use uma conta descartavel e NUNCA
# comite este arquivo (data/ ja esta no .gitignore).
YTDL_COOKIES_FILE=data/cookies.txt

# === Log ===
LOG_LEVEL=INFO
